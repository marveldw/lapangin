# ==================================================
# LAPANGIN - PRODUCTION VPS DOCKER ENVIRONMENT
# ==================================================
# Salin file ini menjadi .env di root project sebelum menjalankan:
# docker compose up -d --build

# App Configuration
APP_NAME=Lapangin
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com
APP_KEY=base64:your_generated_app_key_here

# Frontend API URL (relative '/api' recommended when proxied via Nginx)
NEXT_PUBLIC_API_URL=/api

# Database Configuration (MySQL 8)
DB_DATABASE=lapangin
DB_USERNAME=lapangin_user
DB_PASSWORD=GantiPasswordKuatIni123!
DB_ROOT_PASSWORD=GantiRootPasswordKuatIni456!

# MySQL Memory Tuning (128M for 1GB VPS, 256M for 2GB VPS)
MYSQL_BUFFER_POOL_SIZE=128M

# Midtrans Production / Sandbox Credentials
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxx
MIDTRANS_IS_PRODUCTION=false
